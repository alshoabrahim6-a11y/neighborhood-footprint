# ============================================================================
# انسخ هاد الملف وسمّيه ".env" (بدون .example) وعبّي القيم تحت
# ما تشارك ملف .env مع حدا ولا ترفعه ع GitHub — فيه مفاتيح سرية!
# ============================================================================

# رقم البورت اللي بيشتغل عليه السيرفر عندك
PORT=4000

# من لوحة تحكم Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here

# اسم الـ bucket اللي أنشأته بـ Supabase Storage لتخزين صور البلاغات
SUPABASE_STORAGE_BUCKET=pollution-photos

# من huggingface.co/settings/tokens (سجل حساب مجاني ثم Create new token)
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
