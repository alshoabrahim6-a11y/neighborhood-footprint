# ============================================================================
# Copy this file and name it ".env" (without .example) and fill in the
# values below.
# Don't share the .env file with anyone or upload it to GitHub — it has
# secret keys!
# ============================================================================

# The port number your server runs on
PORT=4000

# From the Supabase dashboard: Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here

# The name of the bucket you created in Supabase Storage to store report photos
SUPABASE_STORAGE_BUCKET=pollution-photos

# From huggingface.co/settings/tokens (sign up for a free account then Create new token)
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
