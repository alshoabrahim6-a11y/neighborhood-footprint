# Copy this file and name it ".env" (without .example)

# The address of the backend server running locally
VITE_API_BASE_URL=http://localhost:4000

# ------------------------------------------------------------------------
# Login settings (Supabase Auth)
# ------------------------------------------------------------------------
# These values come from the same Supabase project (Project Settings > API):
#   - VITE_SUPABASE_URL       → same "Project URL" used in backend/.env
#   - VITE_SUPABASE_ANON_KEY  → the "anon public" key (not service_role!)
#
# ⚠️ Important security note: this "anon" key is 100% safe to put in the
# frontend and it shows up in the browser's code — that's normal and
# intentional, since it's designed from the start to be public. The
# dangerous one is only the "service_role" key (which lives in
# backend/.env), and that must always stay secret and never be put here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
