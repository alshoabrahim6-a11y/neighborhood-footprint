# انسخ هاد الملف وسمّيه ".env" (بدون .example)

# عنوان السيرفر الخلفي (backend) اللي شغال عندك محليًا
VITE_API_BASE_URL=http://localhost:4000

# ------------------------------------------------------------------------
# إعدادات تسجيل الدخول (Supabase Auth)
# ------------------------------------------------------------------------
# هاي القيم من نفس مشروع Supabase تبعك (Project Settings > API):
#   - VITE_SUPABASE_URL       → نفس "Project URL" يلي استخدمته بملف backend/.env
#   - VITE_SUPABASE_ANON_KEY  → مفتاح "anon public" (مش service_role!)
#
# ⚠️ ملاحظة أمان مهمة: مفتاح "anon" هاد آمن 100% نحطه بالواجهة الأمامية
# (frontend) ويظهر بكود المتصفح — هاد طبيعي ومقصود، لأنه مصمم من الأساس
# ليكون عام. الخطير هو مفتاح "service_role" بس (يلي موجود بـ backend/.env)،
# وهاد لازم يضل سري دايمًا وما ينحط هون أبدًا.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
